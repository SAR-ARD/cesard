    "GeometricAccuracyMetadata": {
      "additionalProperties": false,
      "description": "Horizontal geolocation accuracy metadata.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "eastern": {
          "$ref": "#/$defs/AxisAccuracy"
        },
        "northern": {
          "$ref": "#/$defs/AxisAccuracy"
        },
        "radial_rmse": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/NotImplementedNumber"
            }
          ],
          "description": "Radial RMSE in metres, or -99999 if derivation of this mandatory metadata value is not yet implemented.",
          "title": "Radial Rmse"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/NotImplementedText"
            }
          ],
          "description": "Reference documenting the accuracy estimate, or 'TBD' if this mandatory value is not yet implemented.",
          "title": "Reference"
        }
      },
      "required": [
        "type",
        "eastern",
        "northern",
        "radial_rmse",
        "reference"
      ],
      "title": "GeometricAccuracyMetadata",
      "type": "object"
    },
    "GeometricCorrectionMetadata": {
      "additionalProperties": false,
      "description": "Geometric correction algorithm and resulting accuracy.",
      "properties": {
        "algorithm": {
          "title": "Algorithm",
          "type": "string"
