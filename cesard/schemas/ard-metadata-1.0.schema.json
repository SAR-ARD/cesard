          "title": "Orbit Direction",
          "type": "string"
        },
        "orbit_mean_altitude": {
          "exclusiveMinimum": 0,
          "title": "Orbit Mean Altitude",
          "type": "number"
        },
        "orbit_number_absolute": {
          "minimum": 0,
          "title": "Orbit Number Absolute",
          "type": "integer"
        },
        "orbit_number_relative": {
          "minimum": 0,
          "title": "Orbit Number Relative",
          "type": "integer"
        },
        "platform_full_name": {
          "title": "Platform Full Name",
          "type": "string"
        },
        "platform_identifier": {
          "title": "Platform Identifier",
          "type": "string"
        },
        "platform_reference": {
          "title": "Platform Reference",
          "type": "string"
        },
        "platform_short_name": {
          "title": "Platform Short Name",
          "type": "string"
        },
        "polarizations": {
          "items": {
            "enum": [
              "HH",
              "HV",
              "VH",
              "VV"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Polarizations",
          "type": "array"
        },
        "polarization_mode": {
          "title": "Polarization Mode",
          "type": "string"
        },
        "processing_level": {
          "title": "Processing Level",
          "type": "string"
        },
        "radar_band": {
          "title": "Radar Band",
          "type": "string"
        },
        "radar_center_frequency": {
          "exclusiveMinimum": 0,
          "title": "Radar Center Frequency",
          "type": "number"
        },
        "sensor_type": {
          "title": "Sensor Type",
          "type": "string"
        },
        "swath_identifier": {
          "title": "Swath Identifier",
          "type": "string"
        },
        "wrs_longitude_grid": {
          "minimum": 0,
          "title": "Wrs Longitude Grid",
          "type": "integer"
        }
      },
      "required": [
        "antenna_look_direction",
        "constellation",
        "instrument_short_name",
        "operational_mode",
        "orbit_direction",
        "orbit_mean_altitude",
        "orbit_number_absolute",
        "orbit_number_relative",
        "platform_full_name",
        "platform_identifier",
        "platform_reference",
        "platform_short_name",
        "polarizations",
        "polarization_mode",
        "processing_level",
        "radar_band",
        "radar_center_frequency",
        "sensor_type",
        "swath_identifier",
        "wrs_longitude_grid"
      ],
      "title": "CommonMetadata",
      "type": "object"
    },
    "CompressionMetadata": {
      "additionalProperties": false,
