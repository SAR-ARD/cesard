{
  "$comment": "Reserved CESARD implementation sentinels: NOT_IMPLEMENTED_NUMBER = -99999; NOT_IMPLEMENTED_TEXT = 'TBD'. These values denote mandatory metadata whose derivation is not yet implemented and are distinct from null/None.",
  "$defs": {
    "AxisAccuracy": {
      "additionalProperties": false,
      "description": "Bias and standard deviation along one horizontal axis.\n\n``-99999`` is reserved for a mandatory value whose derivation is not yet\nimplemented by the producer. ``None`` is deliberately not accepted.",
      "properties": {
        "bias": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/NotImplementedNumber"
            }
          ],
          "description": "Horizontal bias, or -99999 if derivation of this mandatory metadata value is not yet implemented.",
          "title": "Bias"
        },
        "standard_deviation": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "$ref": "#/$defs/NotImplementedNumber"
            }
          ],
          "description": "Horizontal standard deviation, or -99999 if derivation of this mandatory metadata value is not yet implemented.",
          "title": "Standard Deviation"
        }
      },
      "required": [
        "bias",
        "standard_deviation"
      ],
      "title": "AxisAccuracy",
      "type": "object"
    },
    "BackscatterMetadata": {
      "additionalProperties": false,
      "description": "Backscatter measurement representation and multilooking metadata.",
      "properties": {
        "measurement": {
          "title": "Measurement",
          "type": "string"
        },
        "convention": {
          "title": "Convention",
          "type": "string"
        },
        "conversion_equation": {
          "title": "Conversion Equation",
          "type": "string"
        },
        "range_number_of_looks": {
          "exclusiveMinimum": 0,
          "title": "Range Number Of Looks",
          "type": "number"
        },
        "azimuth_number_of_looks": {
          "exclusiveMinimum": 0,
          "title": "Azimuth Number Of Looks",
          "type": "number"
        },
        "equivalent_number_of_looks": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equivalent Number Of Looks"
        }
      },
      "required": [
        "measurement",
        "convention",
        "conversion_equation",
        "range_number_of_looks",
        "azimuth_number_of_looks"
      ],
      "title": "BackscatterMetadata",
      "type": "object"
    },
    "Card4lMetadata": {
      "additionalProperties": false,
      "description": "Reference to the applicable CARD4L product-family specification.",
      "properties": {
        "specification": {
          "title": "Specification",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "document": {
          "title": "Document",
          "type": "string"
        }
      },
      "required": [
        "specification",
        "version",
        "document"
      ],
      "title": "Card4lMetadata",
      "type": "object"
    },
    "CommonMetadata": {
      "additionalProperties": false,
      "description": "Metadata shared by the ARD product and all contributing source scenes.",
      "properties": {
        "antenna_look_direction": {
          "enum": [
            "LEFT",
            "RIGHT"
          ],
          "title": "Antenna Look Direction",
          "type": "string"
        },
        "constellation": {
          "title": "Constellation",
          "type": "string"
        },
        "instrument_short_name": {
          "title": "Instrument Short Name",
          "type": "string"
        },
        "operational_mode": {
          "title": "Operational Mode",
          "type": "string"
        },
        "orbit_direction": {
          "enum": [
            "ascending",
            "descending"
